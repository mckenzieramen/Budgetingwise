rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function isAdmin(){return signedIn() && request.auth.token.admin == true;}
    function own(uid){return signedIn() && request.auth.uid == uid;}

    match /users/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create: if isAdmin() || (own(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.mustChangePassword == true);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mustChangePassword',
          'accountActivated',
          'activatedAt',
          'passwordChangedAt'
        ]));
      match /transactions/{id} { allow read, write: if own(uid) || isAdmin(); }
      match /goals/{id} { allow read, write: if own(uid) || isAdmin(); }
    }

    match /supportThreads/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create: if own(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.customerUnread == 0
        && request.resource.data.status == 'open'
        || isAdmin();
      allow update: if isAdmin() || (own(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid','customerEmail','customerName','budgetId','guest','customerUnread',
          'status','createdAt','updatedAt','lastSender','adminUnread',
          'requestType','activationKeyRequested','rating'
        ]));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if own(uid) || isAdmin();
        allow create: if (own(uid)
          && request.resource.data.sender == 'customer'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 800)
          || (isAdmin() && request.resource.data.sender == 'admin');
        allow update, delete: if isAdmin();
      }
    }
  }
}
